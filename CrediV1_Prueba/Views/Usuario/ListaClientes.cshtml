@model IEnumerable<CrediV1_Prueba.Entities.UsuarioEnt>
@{
    ViewData["Title"] = "Listado de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="~/css/tablas.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.css">
}

<div class="container">
    <div class="container mt-4">

        <a href="@Url.Action("AgregarCliente", "Usuario")" class="btn" type="submit" id="button-addon2">
            <i class="fa fa-plus"></i> Agregar Cliente
        </a>
        <a href="@Url.Action("Usuarios", "Usuario")" class="btn" type="submit" id="button-addon2">
            <i class="fa fa-sign-out-alt"></i> Volver
        </a>

    </div>

    <div class="container mt-4">
        <table id="usuariosTable" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo Electrónico</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var usuario in Model)
                {

                    @if(usuario.idRol == 5)
                    {
                        <tr>
                            <td>@usuario.nombreCompleto</td>
                            <td>@usuario.telefono</td>
                            <td>@usuario.correo</td>
                            @if (usuario.estado)
                            {
                                <td>Activo</td>
                                <td style="text-align:start">
                                    <button class="btn btn-danger confirmButtonInactivar"
                                            data-id="@usuario.idUsuario"
                                            data-nombre="@usuario.nombre"
                                            data-correo="@usuario.correo"
                                            data-telefono="@usuario.telefono"
                                            data-estado="false">
                                        Inactivar
                                    </button>
                                    <a class="btn btn-warning" asp-controller="Usuario" asp-action="EditarUsuario" asp-route-Usuario="@usuario.idUsuario">
                                        <i class="fa fa-edit"></i> Editar
                                    </a>
                                    <button class="btn" onclick="enviarNotificacion('@usuario.nombreCompleto', '@usuario.correo')">
                                        <i class="fa fa-envelope"></i> Enviar Notificación
                                    </button>
                                </td>
                            }
                            else
                            {
                                <td>Inactivo</td>
                                <td style="text-align:start">
                                    <button class="btn btn-success confirmButtonInactivar"
                                            data-id="@usuario.idUsuario"
                                            data-nombre="@usuario.nombre"
                                            data-correo="@usuario.correo"
                                            data-telefono="@usuario.telefono"
                                            data-estado="true">
                                        Activar
                                    </button>
                                    <a class="btn btn-warning" asp-controller="Usuario" asp-action="EditarUsuario" asp-route-Usuario="@usuario.idUsuario">Editar</a>
                                    <button class="btn " onclick="enviarNotificacion('@usuario.nombreCompleto', '@usuario.correo')">
                                        <i class="fa fa-envelope"></i> Enviar Notificación
                                    </button>
                                </td>
                            }
                        </tr>
                    }
                   
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        function enviarNotificacion(usuario, correo) {
            Swal.fire({
                title: 'Enviar Notificación',
                html: `
                            <div class="mb-3">
                                <label class="form-label">Usuario:</label>
                                <input type="text" class="form-control" id="usuario" readonly value="${usuario}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Correo Electrónico:</label>
                                <input type="email" class="form-control" id="correo" readonly value="${correo}">
                            </div>
                            <div class="mb-3">
                                <label class="form-label">Mensaje:</label>
                                <textarea class="form-control" id="mensaje" rows="5" placeholder="Escribe tu mensaje aquí..."></textarea>
                            </div>
                        `,
                showCancelButton: true,
                confirmButtonText: 'Enviar',
                cancelButtonText: 'Cancelar',
                focusConfirm: false,
                preConfirm: () => {
                    const mensaje = document.getElementById('mensaje').value;

                    if (!mensaje) {
                        Swal.showValidationMessage('El mensaje no puede estar vacío');
                        return false;
                    }

                    const data = {
                        usuario: usuario,
                        correo: correo,
                        mensaje: mensaje
                    };

                    return fetch('/Usuario/EnviarNotificacion', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(response.statusText);
                            }

                            return response.json();
                        })
                        .catch(error => {
                            Swal.showValidationMessage(`Error al enviar la notificación: ${error}`);
                        });
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Notificación enviada',
                        text: 'La notificación se ha enviado correctamente.',
                        showConfirmButton: false,
                        timer: 1500
                    });
                }
            });
        }

        $(document).ready(function () {
            $('#usuariosTable').DataTable({
                "paging": true,
                "searching": true,
                "info": true,
                "ordering": true,
                "pageLength": 10,
                "language": {
                    "paginate": {
                        "previous": "Anterior",
                        "next": "Siguiente"
                    },
                    "search": "Buscar:",
                    "lengthMenu": "Mostrar _MENU_ filas por página",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ filas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 filas",
                    "emptyTable": "No hay datos disponibles en la tabla",
                    "infoFiltered": "(filtrado de _MAX_ filas en total)",
                    "zeroRecords": "No se encontraron coincidencias"
                }
            });



            $('.confirmButtonInactivar').on('click', function () {
                let idUsuario = $(this).data('id');
                let nombre = $(this).data('nombre');
                let correo = $(this).data('correo');
                let telefono = $(this).data('telefono');
                let estado = $(this).data('estado');

                let accion = estado ? "activar" : "inactivar";

                Swal.fire({
                    title: `¿Estás seguro de ${accion} a ${correo}?`,
                    text: ``,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sí, continuar',
                    cancelButtonText: 'Cancelar'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch('/Usuario/DesactivarActivarUsuario', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ idUsuario: idUsuario })
                            });

                            if (response.ok) {
                                const mensaje = await response.text();
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Acción Realizada',
                                    text: mensaje
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                throw new Error('Error en la solicitud');
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Hubo un problema al cambiar el estado del usuario.'
                            });
                        }
                    }
                });
            });
        });
    </script>
}
