@model IEnumerable<CrediV1_Prueba.Entities.UsuarioEnt>
@{
    ViewData["Title"] = "Listado de Usuarios";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container">

    <div class="container mt-4">
        <a href="@Url.Action("AgregarEmpleado","Usuario")" class="btn" type="submit" id="button-addon2"> <i class="fa fa-plus"></i> Agregar Cliente </a>
        <a href="@Url.Action("Usuarios","Usuario")" class="btn" type="submit" id="button-addon2"> <i class="fa fa-plus"></i> Volver  </a>
        <div class="row justify-content-end">
            <div class="col-md-6">
                <form action="#" method="GET" class="form-inline">
                    <div class="input-group">
                        <input type="text" class="form-control" placeholder="Buscar..." aria-label="Buscar" aria-describedby="button-addon2">
                        <div class="input-group-append">
                            <button class="btn" type="submit" id="button-addon2"> <i class="fa fa-search"></i> </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <div class="container mt-4">
        <table class="table table-hover" style="text-align:center">
            <thead>
                <tr>
                    <th>Nombre</th>
                    <th>Teléfono</th>
                    <th>Correo Electrónico</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>


                @foreach (var usuario in @Model)
                {

                   
                        <tr>
                            <input type="hidden" name="idUsuario" id="idUsuario" value="@usuario.idUsuario" />
                            <td>@usuario.nombreCompleto</td>
                            <td>@usuario.telefono</td>
                            <td>@usuario.idRol</td>
                            @if (usuario.estado == true)
                            {
                                <td>Activo</td>
                                <td style="text-align:center">
                                    <button class="btn btn-danger confirmButtonInactivar"
                                            data-id="@usuario.idUsuario"
                                            data-nombre="@usuario.nombre"
                                            data-correo="@usuario.correo"
                                            data-telefono="@usuario.telefono"
                                            data-estado="true">
                                        Inactivar
                                    </button>
                                </td>
                            }
                            else
                            {
                                <td>Isnactivo</td>
                                <td style="text-align:center">
                                    <button class="btn btn-success confirmButtonInactivar"
                                            data-id="@usuario.idUsuario"
                                            data-nombre="@usuario.nombre"
                                            data-correo="@usuario.correo"
                                            data-telefono="@usuario.telefono"
                                            data-estado="false">
                                        Activar
                                    </button>
                                </td>
                            }
                            <td>
                                <a class="btn btn-warning" asp-controller="Usuario" asp-action="EditarUsuario" asp-route-Usuario="@usuario.idUsuario">Editar</a>
                            </td>
                        </tr>
                    
                 
                }
            </tbody>


        </table>
    </div>
    <nav aria-label="Page navigation example" style="background-color:white">
        <ul class="pagination justify-content-center" style="background-color:#dce5e4">
            <li class="page-item disabled">
                <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Anterior</a>
            </li>
            <li class="page-item"><a class="page-link" href="#">1</a></li>
            <li class="page-item"><a class="page-link" href="#">2</a></li>
            <li class="page-item"><a class="page-link" href="#">3</a></li>
            <li class="page-item">
                <a class="page-link" href="#">Siguiente</a>
            </li>
        </ul>
    </nav>

</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>


<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

<script>
    document.querySelectorAll('.confirmButtonInactivar').forEach(button => {
        button.addEventListener('click', async function () {
            let idUsuario = this.getAttribute('data-id');
            let estado = this.getAttribute('data-estado') === 'true';

            const data = {
                idUsuario: parseInt(idUsuario)
            };

            Swal.fire({
                title: '¿Estás seguro?',
                text: estado ? "¿Quieres inactivar este usuario?" : "¿Quieres activar este usuario?",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#0d6efd',
                cancelButtonColor: '#c31e1e',
                confirmButtonText: 'Sí',
                cancelButtonText: 'Cancelar'
            }).then(async (result) => {
                if (result.isConfirmed) {
                    try {
                        const response = await fetch('@Url.Action("DesactivarActivarUsuario", "Usuario")', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(data)
                        });

                        if (response.ok) {
                            const mensaje = await response.text();
                            Swal.fire({
                                icon: 'success',
                                title: 'Acción Realizada',
                                text: mensaje
                            }).then(() => {
                                // Actualiza la vista sin recargar la página
                                const row = button.closest('tr');
                                const estadoCell = row.querySelector('td:nth-child(4)');
                                const accionButton = row.querySelector('.confirmButtonInactivar');

                                if (estado) {
                                    estadoCell.textContent = 'Inactivo';
                                    accionButton.classList.remove('btn-danger');
                                    accionButton.classList.add('btn-success');
                                    accionButton.textContent = 'Activar';
                                    accionButton.setAttribute('data-estado', 'false');
                                } else {
                                    estadoCell.textContent = 'Activo';
                                    accionButton.classList.remove('btn-success');
                                    accionButton.classList.add('btn-danger');
                                    accionButton.textContent = 'Inactivar';
                                    accionButton.setAttribute('data-estado', 'true');
                                }
                            });
                        } else {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Hubo un problema al cambiar el estado del usuario.'
                            });
                        }
                    } catch (error) {
                        Swal.fire({
                            icon: 'error',
                            title: 'Error',
                            text: 'Hubo un problema al cambiar el estado del usuario.'
                        });
                    }
                }
            });
        });
    });
</script>

