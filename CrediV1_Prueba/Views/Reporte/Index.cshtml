@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.12.1/css/all.min.css" integrity="sha256-mmgLkCYLUQbXn0B1SRqzHar6dCnv9oZFPEC1g1cwlkk=" crossorigin="anonymous" />
    <link href="~/css/Reportes.css" rel="stylesheet" />

    <style>
        canvas {
            max-width: 1000px; /* Puedes ajustar este valor según el tamaño que desees */
            max-height: 600px; /* Puedes ajustar este valor según el tamaño que desees */
            width: 300px;
            height: 300px;
            justify-content: center;
        }
    </style>
}

<div class="container">
    <div class="container mt-4">
        <div class="text-center">
            <div class="">
                <h1>Inventario <span clsas="d-block">- Salidas</span></h1>
            </div>
        </div>
        <div class="container">
            <div class="row ">
                <div class="col-xl-6 col-lg-6">
                    <div class="text-decoration-none">
                        <div class="card l-bg-cherry">
                            <div class="card-statistic-5 p-5">
                                <div class="card-icon card-icon-large"><i class="fas fa-shopping-cart"></i></div>
                                <div class="mb-4">
                                    <h5 class="card-title mb-0">Ventas</h5>
                                </div>
                                <div class="row align-items-center mb-2 d-flex">
                                    <div class="col-8 text-center">
                                        <h2 class="d-flex align-items-center mb-0 text''">
                                            3,243
                                        </h2>
                                    </div>
                                    <div class="col-4 text-center">
                                        <span>24h <i class="fa fa-arrow-up"></i></span>
                                    </div>
                                </div>
                                <div class="progress mt-1" data-height="8" style="height: 8px;">
                                    <div class="progress-bar l-bg-cyan" role="progressbar" data-width="25%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100" style="width: 25%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6">
                    <div class="text-decoration-none">
                        <div class="card l-bg-blue-dark">
                            <div class="card-statistic-5 p-5">
                                <div class="card-icon card-icon-large"><i class="fas fa-users"></i></div>
                                <div class="mb-4">
                                    <h5 class="card-title mb-0">Abonos</h5>
                                </div>
                                <div class="row align-items-center mb-2 d-flex">
                                    <div class="col-8">
                                        <h2 class="d-flex align-items-center mb-0">
                                            15.07k
                                        </h2>
                                    </div>
                                    <div class="col-4 text-right">
                                        <span>24h<i class="fa fa-arrow-up"></i></span>
                                    </div>
                                </div>
                                <div class="progress mt-1" data-height="8" style="height: 8px;">
                                    <div class="progress-bar l-bg-green" role="progressbar" data-width="25%" aria-valuenow="25" aria-valuemin="0" aria-valuemax="100" style="width: 25%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6">
                    <div class="text-decoration-none">
                        <div class="card">
                            <canvas id="GraficoLinealVentasSemana"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-xl-6 col-lg-6">
                    <div class="text-decoration-none">
                        <div class="card">
                            <canvas id="miGraficoRadar"></canvas>
                        </div>
                    </div>
                </div>
                <div class="col-xl-12 col-lg-12">
                    <div class="text-decoration-none">
                        <div class="card">
                            <div class="card-statistic-5 p-5 d-flex justify-content-center bg-white">
                                <canvas id="GraficoBarras"></canvas>
                            </div>
                            <div>
                                <span class="card title">Excel <i class="fa fa-download"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
                <div class="col-xl-12 col-lg-12">
                    <div class="text-decoration-none">
                        <div class="card">
                            <div class="card-statistic-5 p-5 d-flex justify-content-center bg-white">
                                <canvas id="GraficoPie"></canvas>
                            </div>
                            <div>
                                <span class="card title">Excel <i class="fa fa-download"></i></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        const DATA_COUNT = 5;
        const NUMBER_CFG = { count: DATA_COUNT, min: 0, max: 100 };



        var ctx = document.getElementById('GraficoPie').getContext('2d');
        var barChart = document.getElementById('GraficoBarras').getContext('2d');
        var LineChart = document.getElementById('GraficoLinealVentasSemana').getContext('2d');
        var RadarChart = document.getElementById('miGraficoRadar').getContext('2d');

        const data = {
            labels: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio'],
            datasets: [{
                label: 'Ventas por Mes',
                data: [300, 50, 100, 40, 120, 60], // Datos de ventas para cada mes
                backgroundColor: [
                    'rgb(255, 99, 132)',   // Rojo
                    'rgb(54, 162, 235)',   // Azul
                    'rgb(255, 205, 86)',   // Amarillo
                    'rgb(75, 192, 192)',   // Verde
                    'rgb(153, 102, 255)',  // Púrpura
                    'rgb(255, 159, 64)'    // Naranja
                ],
                hoverOffset: 4
            }]
        };

        const dataDaily = {
            labels: ['Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado'],
            datasets: [{
                label: 'Ventas de la semana',
                data: data, // Datos de ventas para cada mes
                backgroundColor: [
                    'rgb(255, 99, 132)',   // Rojo
                    'rgb(54, 162, 235)',   // Azul
                    'rgb(255, 205, 86)',   // Amarillo
                    'rgb(75, 192, 192)',   // Verde
                    'rgb(153, 102, 255)',  // Púrpura
                    'rgb(255, 159, 64)'    // Naranja
                ],
                hoverOffset: 4
            }]
        };

        const config = {
            type: 'doughnut',
            data: data,
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    title: {
                        display: true,
                        text: 'Cuentas de Crédito'
                    }
                }
            }
        };

        const configRadar = {
            type: 'line',
            data: data,
            options: {
                plugins: {
                    filler: {
                        propagate: false
                    },
                    'samples-filler-analyser': {
                        target: 'chart-analyser'
                    }
                },
                interaction: {
                    intersect: false
                }
            }
        };

        const configBar = {
            type: 'bar',
            data: data,
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    title: {
                        display: true,
                        text: 'Chart.js Bar Chart'
                    }
                }
            }
        };

        const configLine = {
            type: 'line',
            data: dataDaily,
            options: {
                responsive: true,
                plugins: {
                    legend: {
                        position: 'top',
                    },
                    title: {
                        display: true,
                        text: 'Chart.js Line Chart'
                    }
                }
            }
        };

        // Ejemplo para el gráfico de Ventas Mensuales
        fetch('/Reporte/VentasMensuales')
            .then(response => {
                if (!response.ok) {
                    throw new Error('Network response was not ok');
                }
                return response.json();
            })
            .then(data => {
                const labels = data.map(d => `${d.año}-${d.mes}`);
                const values = data.map(d => d.totalVentas);

                const ctx = document.getElementById('GraficoBarras').getContext('2d');
                new Chart(ctx, {
                    type: 'bar',
                    data: {
                        labels: labels,
                        datasets: [{
                            label: 'Ventas Mensuales',
                            data: values,
                            backgroundColor: 'rgba(75, 192, 192, 0.2)',
                            borderColor: 'rgba(75, 192, 192, 1)',
                            borderWidth: 1
                        }]
                    },
                    options: {
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        }
                    }
                });
            })
            .catch(error => {
                console.error('There has been a problem with your fetch operation:', error);
            });


       
        var myChart = new Chart(LineChart, configLine);
        var myChart = new Chart(RadarChart, configRadar);
    </script>
}
