                            ]),
                            styles: {
                                fontSize: 10,
                                cellPadding: 3,
                                halign: 'center',
                                valign: 'middle',
                                fillColor: [240, 240, 240],
                            },
                            headStyles: {
                                fillColor: [41, 128, 185],
                                textColor: [255, 255, 255],
                            },
                            alternateRowStyles: {
                                fillColor: [255, 255, 255],
                            },
                        });

                        // Añadir pie de página
                        doc.setFontSize(10);
                        doc.text("Este informe es generado automáticamente por el sistema.", 10, doc.internal.pageSize.height - 20);
                        doc.text("Página " + doc.internal.getCurrentPageInfo().pageNumber, 180, doc.internal.pageSize.height - 20);

                        // Guardar el PDF
                        doc.save("Reporte_Ventas_Por_Pagos.pdf");
                    };

                    logoImg.onerror = function () {
                        console.error("Error al cargar la imagen del logo.");
                    };
                }

                // Asigna la función al botón de exportación
                document.getElementById('btnExportarPiePDF').addEventListener('click', () => {
                    exportarPDF(dataJson);
                });
            })
            .catch(error => {
                console.error("Error al cargar los datos:", error);
            });





        fetch('VentasMensuales')
            .then((response) => response.json())
            .then((dataJson) => {
                // Mapea los meses numerados a sus nombres correspondientes
                const meses = ["Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio", "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"];
                console.log(dataJson);

                // Filtrar los datos nulos
                const datosValidos = dataJson.filter(item => item.mes !== null && item.anio !== null);

                // Asigna los labels con el formato "Mes - NombreProducto"
                const labels = datosValidos.map((item) => `${meses[item.mes - 1]} - ${item.nombreProducto}`);

                // Asegúrate de que los valores de ventas son correctos
                const totalVentas = datosValidos.map((item) => item.totalVentas);
                const cantidadVentas = datosValidos.map((item) => item.cantidadVentas);

                const data = {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Total Ventas',
                            data: totalVentas,
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.7)',
                                'rgba(54, 162, 235, 0.7)',
                                'rgba(255, 205, 86, 0.7)',
                                'rgba(1, 175, 64, 0.7)',
                                'rgba(153, 102, 255, 0.7)',
                                'rgba(255, 159, 64, 0.7)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 205, 86, 1)',
                                'rgba(1, 175, 64, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(255, 159, 64, 1)'
                            ],
                            borderWidth: 2
                        },
                        {
                            label: 'Cantidad de Ventas',
                            data: cantidadVentas,
                            backgroundColor: 'rgba(75, 192, 192, 0.7)', // Puedes cambiar el color
                            borderColor: 'rgba(75, 192, 192, 1)', // Puedes cambiar el color
                            borderWidth: 2,
                            type: 'line' // Cambia el tipo de gráfico si deseas mostrar los datos en una línea
                        }
                    ]
                };

                const config = {
                    type: 'bar', // Usa 'bar' o 'line' dependiendo del tipo de gráfico que prefieras
                    data: data,
                    options: {
                        responsive: true,
                        scales: {
                            y: {
                                beginAtZero: true
                            }
                        },
                        plugins: {
                            tooltip: {
                                callbacks: {
                               
                                }
                            },
                            legend: {
                                onClick: (e, legendItem, legend) => {
                                    const index = legendItem.datasetIndex;
                                    const ci = legend.chart;
                                    const meta = ci.getDatasetMeta(index);

                                    // Toggle the visibility of the dataset
                                    meta.hidden = meta.hidden === null ? !ci.data.datasets[index].hidden : null;
                                    ci.update();
                                }
                            }
                        },
                        onClick: (e, elements) => {
                            if (elements.length > 0) {
                                const chart = elements[0].chart;
                                const datasetIndex = elements[0].datasetIndex;
                                const dataIndex = elements[0].index;
                                const ventas = chart.data.datasets[datasetIndex].data[dataIndex];
                                const mesProducto = chart.data.labels[dataIndex];
                                alert(`Ventas en ${mesProducto}: ${ventas.toLocaleString('es-ES', { style: 'currency', currency: 'USD' })}`);
                            }
                        },
                        animation: {
                            duration: 1500, // Duración de la animación
                            easing: 'easeInOutBounce' // Tipo de animación
                        }
                    }
                };

                const canvasBarras = document.getElementById("GraficoBarras").getContext("2d");
                const graficoBarras = new Chart(canvasBarras, config);
            })
            .catch((error) => {
                console.error("Error al cargar los datos:", error);
            });





        $(document).ready(() => {
            resumenProducto();
        });

       
 

    </script>
