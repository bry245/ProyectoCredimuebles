@using CrediV1_Prueba.Entities
@using X.PagedList
@model IPagedList<CrediV1_Prueba.Entities.CajaEnt>
@{
    ViewData["Title"] = "IndexCaja";

}
<div class="text-center ">
    <div class="hero-subMenu">
        <h1>Control <span clsas="d-block"> Caja</span></h1>
    </div>
</div>
@{
    var datosCajas = (CajaEnt)ViewBag.datosCajas;
}

@{
    var errorMessage = ViewBag.MensajeCajas as string;
    if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
    else
    {
    }
    <div class="container">
        <h2>Cajas Diarias</h2>

        <div class="container mt-4">
            <div class="row justify-content-end">
                <div class="col-md-6">
                   
                </div>
            </div>
        </div>
        <table class="table table-hover" style="text-align:center">
            <thead>
                <tr>
                    <th>Fecha</th>
                    <th>Total En Ventas</th>
                    <th>Cantidad Ventas</th>
                    <th>Comisiones</th>
                    <th>Ganancia Neta</th>
                    <th>Gastos</th>
                    


                </tr>
            </thead>
            <tbody style="background-color:#90A9BB ">
                @foreach (var item in Model)
                {//hacer la estrucraaaaaa para cada caja
                    <tr>
                        <td>@item.fechaID.ToString("dd/MM/yyyy")</td>
                        <td> ₡@item.montoVentas</td>
                        <td>  @item.totalVentas </td>
                        <td> ₡@item.comisiones</td>
                        <td> ₡@item.ganancia</td>
                       
                        <td><a class="btn-table-g icon-container" asp-controller="Caja" asp-action="Gastos" asp-route-fecha="@item.fechaID.ToString("yyyy-MM-dd")"> <i class="fas fa-plus"></i> ₡@item.montoGastos</a></td>

                     
                    </tr>
                }
            </tbody>
        </table>
       
            <nav aria-label="Page navigation example" style="background-color:white">
                <ul class="pagination justify-content-center" style="background-color:#dce5e4">
                    <li class="page-item disabled">
                        <a class="page-link" href="#" tabindex="-1" aria-disabled="true">Anterior</a>
                    </li>
                    <li class="page-item"><a class="page-link" href="#">1</a></li>
                    <li class="page-item"><a class="page-link" href="#">2</a></li>
                    <li class="page-item"><a class="page-link" href="#">3</a></li>
                    <li class="page-item">
                        <a class="page-link" href="#">Siguiente</a>
                    </li>
                </ul>

            </nav>
        <div class="row" style="margin-top:2%">
            <div class="col-4">
                <strong style="text-align:center; font-weight:bold; font-size:12pt; line-height:40px">Total en ventas del mes: ₡ @datosCajas.totalVentasMes </strong>

            </div>

            <div class="col-10">
                <strong style="text-align:center; font-weight:bold; font-size:12pt; line-height:40px">Total de gastos: ₡ @datosCajas.montoGastos </strong>

            </div>
            <div class="col-10">
                <strong style="text-align:center; font-weight:bold; font-size:12pt; line-height:40px">Total en caja: ₡ @datosCajas.totalEnCaja </strong>

            </div>
        </div>
       
    </div>


    <!--Modal AGREGAR GASTO-->
    <div class="modal fade" id="gastoModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="confirmModalLabel">Agregar Gasto</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal">
                        <span aria-hidden="true">&times;</span>
                    </button>
                </div>
                <div class="modal-body text-black">
                    <p>Registrar gasto del día 01/01/1900</p>
                    <form>
                        <div class="mb-3">
                            <label class="col-form-label">Monto:</label>
                            <input type="number" class="form-control" id="recipient-name">
                        </div>
                        <div class="mb-3">
                            <label class="text-black" for="message">Por concepto de:</label>
                            <textarea name="" class="form-control" id="message" cols="30" rows="2"></textarea>
                        </div>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-danger" style="background-color:red" data-bs-dismiss="modal">Cancelar</button>
                    <button type="button" class="btn btn-danger" id="confirmButton">Agregar</button>
                </div>
            </div>
        </div>
    </div>
}