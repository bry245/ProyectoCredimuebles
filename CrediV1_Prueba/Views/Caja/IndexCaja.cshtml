@using CrediV1_Prueba.Entities
@using X.PagedList
@model IPagedList<CrediV1_Prueba.Entities.CajaEnt>
@{
    ViewData["Title"] = "IndexCaja";
    Layout = "~/Views/Shared/_Layout.cshtml"; // Asegúrate de tener el layout especificado aquí
}

@section Estilos {
    <link href="~/css/tablas.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.css">
}

@{
    var datosCajas = (CajaEnt)ViewBag.datosCajas;
}

@{
    var errorMessage = ViewBag.MensajeCajas as string;
    if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger">
            @errorMessage
        </div>
    }
}

<div class="container">
    <!-- Alinear el título de la tabla -->
    <div class="row">
        <div class="col-12">
            <h2>Cajas Diarias</h2>
        </div>
    </div>

    <!-- Alinear la tabla dentro de la misma fila -->
    <div class="row">
        <div class="col-12">
            <table id="cajasTable" class="table table-striped table-bordered" style="width:100%">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Total En Ventas</th>
                        <th>Cantidad Ventas</th>
                        <th>Comisiones</th>
                        <th>Ganancia Neta</th>
                        <th>Gastos</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@item.fechaID.ToString("dd/MM/yyyy")</td>
                            <td>₡@item.montoVentas</td>
                            <td>@item.totalVentas</td>
                            <td>₡@item.comisiones</td>
                            <td>₡@item.ganancia</td>
                            <td>
                                <a class="btn-table-g icon-container" asp-controller="Caja" asp-action="Gastos" asp-route-fecha="@item.fechaID.ToString("yyyy-MM-dd")">
                                    <i class="fas fa-plus"></i> ₡@item.montoGastos
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Alinear los datos de la caja con la tabla -->
    <div class="row mt-4">
        <div class="col-4">
            <strong>Total en ventas del mes: ₡ @datosCajas.totalVentasMes</strong>
        </div>
        <div class="col-4">
            <strong>Total de gastos: ₡ @datosCajas.montoGastos</strong>
        </div>
        <div class="col-4">
            <strong>Total en caja: ₡ @datosCajas.totalEnCaja</strong>
        </div>
    </div>
</div>

<!-- Modal para agregar gasto -->
<div class="modal fade" id="gastoModal" tabindex="-1" role="dialog" aria-labelledby="confirmModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="confirmModalLabel">Agregar Gasto</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body text-black">
                <p>Registrar gasto del día 01/01/1900</p>
                <form>
                    <div class="mb-3">
                        <label class="col-form-label">Monto:</label>
                        <input type="number" class="form-control" id="recipient-name">
                    </div>
                    <div class="mb-3">
                        <label class="text-black" for="message">Por concepto de:</label>
                        <textarea class="form-control" id="message" cols="30" rows="2"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-danger" style="background-color:red" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="confirmButton">Agregar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#cajasTable').DataTable({
                "paging": true,
                "searching": true,
                "info": true,
                "ordering": true,
                "pageLength": 10,
                "language": {
                    "paginate": {
                        "previous": "Anterior",
                        "next": "Siguiente"
                    },
                    "search": "Buscar:",
                    "lengthMenu": "Mostrar _MENU_ filas por página",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ filas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 filas",
                    "emptyTable": "No hay datos disponibles en la tabla",
                    "infoFiltered": "(filtrado de _MAX_ filas en total)",
                    "zeroRecords": "No se encontraron coincidencias"
                }
            });
        });
    </script>
}
