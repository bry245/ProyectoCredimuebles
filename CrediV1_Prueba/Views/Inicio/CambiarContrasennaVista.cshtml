@model CrediV1_Prueba.Entities.UsuarioEnt
@{
    ViewData["Title"] = "Cambiar Contraseña";
    Layout = "~/Views/Shared/Layout_login.cshtml";
}

<div class="container">
    <div class="row justify-content-center align-items-center">
        <div class="col-10 login-bg" style="text-align:center">
            <h3 class="section-title">Recuperar Contraseña</h3>
            <form id="resetPasswordForm">
                <div class="row my-5">
                    <div class="col-12 col-md-6">
                        <h4 class="section-title">Ingrese su nueva contraseña</h4>
                        <div class="row">
                            <div class="form-group py-2">
                                <div class="input-login">
                                    <span class="fa fa-envelope p-2"></span>
                                    <!-- Email se mantiene oculto para enviar al controlador -->
                                    <input type="hidden" name="email" id="email" value="@ViewBag.Email" />
                                    <input type="password" id="nuevaContrasenna" name="nuevaContrasenna" class="input-l form-control" placeholder="Nueva Contraseña">
                                </div>
                            </div>
                        </div>
                        <button type="submit" class="btn btn-danger">Cambiar Contraseña <i class="fa-solid fa-arrow-right-to-bracket"></i></button>
                    </div>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- SweetAlert2 JS -->
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    // Manejar el envío del formulario con JavaScript
    document.getElementById('resetPasswordForm').addEventListener('submit', function (event) {
        event.preventDefault();

        const email = document.getElementById('email').value;
        const token = document.getElementById('nuevaContrasenna').value;

        const ResetPasswordViewModel = {
            token,
            email
        };

        fetch('@Url.Action("CambiarContrasenna", "Inicio")', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(ResetPasswordViewModel)
        })
            .then(response => {
                if (response.ok) {
                    return response.text();
                } else {
                    throw new Error('Error al cambiar la contraseña.');
                }
            })
            .then(message => {
                Swal.fire({
                    icon: 'success',
                    title: 'Contraseña cambiada exitosamente',
                    text: message,
                    showConfirmButton: false,
                    timer: 1500
                }).then(() => {
                    window.location.href = '@Url.Action("InicioDeSesion", "Inicio")';
                });
            })
            .catch(error => {
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: error.message,
                });
            });
    });
</script>
