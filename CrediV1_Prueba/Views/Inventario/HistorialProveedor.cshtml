@model IEnumerable<CrediV1_Prueba.Entities.BitacoraProveedor>
@{
    ViewData["Title"] = "Historial Proveedor";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-4">
    <table id="proveedorTable" class="table table-striped table-bordered" style="width:100%">
        <thead>
            <tr>
                <th>Fecha</th>
                <th>Acción</th>
                <th>Usuario</th>
                <th>Proveedor</th>
            </tr>
        </thead>
        <tbody>
            @if (Model != null)
            {
                @foreach (var producto in Model)
                {
                    <tr>
                        <td>@producto.fecha</td>
                        <td>@producto.accion</td>
                        <td>@producto.nombreUsuario</td>
                        <td>@producto.nombreProveedor</td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>

@section Scripts {
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#proveedorTable').DataTable({
                "paging": true,
                "searching": true,
                "info": true,
                "ordering": true,
                "pageLength": 10,
                "language": {
                    "paginate": {
                        "previous": "Anterior",
                        "next": "Siguiente"
                    },
                    "search": "Buscar:",
                    "lengthMenu": "Mostrar _MENU_ filas por página",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ filas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 filas",
                    "emptyTable": "No hay datos disponibles en la tabla",
                    "infoFiltered": "(filtrado de _MAX_ filas en total)",
                    "zeroRecords": "No se encontraron coincidencias"
                }
            });
        });
    </script>
}
