                                <td colspan="4" class="dtr-hidden">
                                    <!-- Clase para ocultar a DataTables -->
                                    <!-- Tabla de detalles del pedido dentro del acordeón -->
                                    <table class="table table-striped mt-3">
                                        <thead>
                                            <tr>
                                                <th>Fecha encargado</th>
                                                <th>Fecha recibido</th>
                                                <th>Producto</th>
                                                <th>Cantidad</th>
                                                <th>Monto Unitario</th>
                                                <th>Monto Total</th>
                                                <th>Proveedor</th>
                                                <th>Confirmar Pedido</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var detalle in ViewBag.PedidosDetalles)
                                            {
                                                @if (detalle.idPedido == pedido.idPedido)
                                                {
                                                    <tr>
                                                        <input type="hidden" class="idDetallePedido" name="idDetallePedido" value="@detalle.idDetalle" />

                                                        <td>@detalle.fechaEncargo</td>
                                                        @if (@detalle.fechaRecibido == null)
                                                        {
                                                            <td>Aún no recibido</td>
                                                        }
                                                        else
                                                        {
                                                            <td>@detalle.fechaRecibido</td>
                                                        }
                                                        <td>@detalle.nombreProducto</td>
                                                        <td>@detalle.cantidad</td>
                                                        <td>@detalle.montoUnitario</td>
                                                        <td>@detalle.montoTotalProducto</td>
                                                        <td>@detalle.nombreProveedor</td>
                                                        @if (detalle.fechaRecibido == null)
