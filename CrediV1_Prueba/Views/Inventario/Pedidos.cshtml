                                <td>@pedido.fechaEncargo</td>
                                <td>@pedido.estado</td>
                                <td>@pedido.montoTotalPedido</td>
                                <td>
                                    <!-- Botón para desplegar el acordeón -->
                                    <button type="button" class="btn " data-mdb-toggle="collapse" data-mdb-target="#collapse_@pedido.idPedido" aria-expanded="false" aria-controls="collapse_@pedido.idPedido">
                                        <i class="fas fa-eye"></i>
                                    </button>
                                </td>
                            </tr>
                            <!-- Fila con la tabla anidada, ignorada por DataTables -->
