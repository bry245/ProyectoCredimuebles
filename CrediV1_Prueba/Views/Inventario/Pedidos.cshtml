@section Scripts {
 
     <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>

    <script src="https://cdn.datatables.net/1.13.1/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.7.2/js/dataTables.buttons.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.1.3/jszip.min.js"></script>
    <script src="https://cdn.datatables.net/buttons/1.7.2/js/buttons.html5.min.js"></script>



    <script>

        function enviarNotificacion(usuario, correo) {
            Swal.fire({
                title: 'Enviar Notificación',
                html: `
                    <div class="mb-3">
                        <label class="form-label">Usuario:</label>
                        <input type="text" class="form-control" id="usuario" readonly value="${usuario}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Correo Electrónico:</label>
                        <input type="email" class="form-control" id="correo" readonly value="${correo}">
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Mensaje:</label>
                        <textarea class="form-control" id="mensaje" rows="5" placeholder="Escribe tu mensaje aquí..."></textarea>
                    </div>
                `,
                showCancelButton: true,
                confirmButtonText: 'Enviar',
                cancelButtonText: 'Cancelar',
                focusConfirm: false,
                preConfirm: () => {
                    const mensaje = document.getElementById('mensaje').value;

                    if (!mensaje) {
                        Swal.showValidationMessage('El mensaje no puede estar vacío');
                        return false;
                    }

                    const data = {
                        usuario: usuario,
                        correo: correo,
                        mensaje: mensaje
                    };

                    return fetch('/Inventario/EnviarNotificacion', {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify(data)
                    })
                        .then(response => {
                            if (!response.ok) {
                                throw new Error(response.statusText);
                            }
                            return response.json();
                        })
                        .catch(error => {
                            Swal.showValidationMessage(`Error al enviar la notificación: ${error}`);
                        });
                }
            }).then((result) => {
                if (result.isConfirmed) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Notificación enviada',
                        text: 'La notificación se ha enviado correctamente.',
                        showConfirmButton: false,
                        timer: 1500
                    });
                }
            });
        }
    </script>


    <script>
        function enviarIdDetallePedido(button) {
            // Encuentra la fila más cercana al botón clicado
            const row = button.closest('tr');
            // Busca el input de tipo hidden dentro de esa fila
            const idDetalle = row.querySelector('.idDetallePedido').value;

            console.log(idDetalle);  // Para verificar si estás obteniendo la ID correcta

            // Crear el objeto RegistrarPedidoDTO correctamente
            const ent = {
                idDetalle: idDetalle
            };

            fetch('/Inventario/RecibirProductoPedido', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(ent)
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Error en la solicitud');
                    }
                    return response.json();
                })
                .then(data => {
                    console.log('Respuesta del servidor:', data);

                    Swal.fire({
                        title: 'Éxito',
                        text: 'ID enviada correctamente',
                        icon: 'success',
                        confirmButtonText: 'Aceptar'
                    });
                    location.reload();
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        title: 'Error',
                        text: error.message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar'
                    });
                });
        }



    
    </script>




    <script>

       var productos = @Html.Raw(JsonConvert.SerializeObject(ViewBag.Productos));

        function buscarProducto() {
            var textoBusqueda = $('#buscarProducto').val().toLowerCase();

            var html = '<ul class="list-group">';
            productos.forEach(function (producto) {
                if (producto.nombre.toLowerCase().includes(textoBusqueda)) {
                    html += '<li class="list-group-item" style="cursor: pointer;" onclick="agregarProducto(' + producto.idProducto + ', \'' + producto.nombre + '\', ' + producto.CostoProveedor + ', \'' + producto.nombreProveedor + '\', ' + producto.idProveedor + ')">' + producto.nombre + ' ₡' + producto.CostoProveedor + '</li>';
                }
            });
            html += '</ul>';

            $('#resultadosProductos').html(html);
        }

    var proveedores = []; // Array para almacenar los proveedores únicos

        function agregarProducto(id, nombre, CostoProveedor, proveedor, idProveedor) {
            var filaExistente = $('#productosSeleccionados tr[data-id="' + id + '"]');
            if (filaExistente.length > 0) {
                // Si el producto ya está en la tabla, actualiza la cantidad y el total
                var cantidadInput = filaExistente.find('input[name="cantidad"]');
                var nuevaCantidad = parseInt(cantidadInput.val()) + 1;
                cantidadInput.val(nuevaCantidad);
                filaExistente.find('input[name="total"]').val(nuevaCantidad * CostoProveedor);
            } else {
                // Si el producto no está en la tabla, agrégalo con los nuevos inputs
                var fila = '<tr data-id="' + id + '" data-proveedor-id="' + idProveedor + '">' +
                    '<td>' + nombre + '</td>' +
                    '<td><input type="number" name="cantidad" min="1" value="1" class="form-control" onchange="actualizarTotal(this, ' + CostoProveedor + ')" /></td>' +
                    '<td><input type="number" name="precio" value="' + CostoProveedor + '" class="form-control" readonly /></td>' +
                    '<td><input type="number" name="total" value="' + CostoProveedor + '" class="form-control" readonly /></td>' +
                    '</tr>';
                $('#productosSeleccionados').append(fila);
            }

            // Verificar si el proveedor ya está en la lista
            if (!proveedores.includes(proveedor)) {
                proveedores.push(proveedor);
                var proveedorInput = '<div class="input-group mb-3">' +
                    '<div class="input-group-prepend">' +
                    '<span class="input-group-text"><i class="fas fa-user"></i></span>' +
                    '</div>' +
                    '<input type="text" name="proveedores[]" value="' + proveedor + '" class="form-control form-control-lg" readonly />' +
                    '</div>';
                $('#proveedorInputs').append(proveedorInput);
            }

            limpiarBuscador();
            actualizarCostoTotal();
        }


        function actualizarTotal(input, CostoProveedor) {
        var cantidad = $(input).val();
        var totalInput = $(input).closest('tr').find('input[name="total"]');
        totalInput.val(cantidad * CostoProveedor);
        actualizarCostoTotal();
    }

    function actualizarCostoTotal() {
        var totalPedido = 0;

        $('#productosSeleccionados tr').each(function () {
            var totalProducto = $(this).find('input[name="total"]').val();
            totalPedido += parseFloat(totalProducto);
        });

        // Asigna el total calculado al input de costoTotal
        $('#costoTotal').val(totalPedido.toFixed(2));
    }


        function limpiarBuscador() {
            $('#buscarProducto').val('');
            $('#resultadosProductos').html('');
        }

        $(document).ready(function () {
            $('#buscarProducto').keyup(function () {
                buscarProducto();
            });
        });

        function RegistrarPedido() {
            var productosSeleccionados = [];
            $('#productosSeleccionados tr').each(function () {
                var id = $(this).data('id');
                var cantidad = $(this).find('td:eq(1) input').val();
                var precio = $(this).find('td:eq(2) input').val();
                var total = $(this).find('td:eq(3) input').val();
                var idProveedor = $(this).data('proveedor-id');

                var producto = {
                    idProducto: id,
                    idProveedor: idProveedor,
                    cantidad: parseInt(cantidad),  // Agrega la cantidad aquí
                    montoUnitario: parseFloat(precio),
                    montoTotalProducto: parseFloat(total),
                    montoTotalPedido: parseFloat($('#costoTotal').val())
                };
                productosSeleccionados.push(producto);
            });

            // Usando fetch para realizar la solicitud
            fetch('/Inventario/RegistrarPedido', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(productosSeleccionados)  // Enviando todos los productos seleccionados
            })
                .then(response => {
                    if (!response.ok) {
                        throw new Error('Ocurrió un error al registrar el pedido');
                    }
                    return response.json(); // Esto asume que el servidor devuelve un JSON en la respuesta
                })
                .then(data => {
                    Swal.fire({
                        title: 'Éxito',
                        text: 'Pedido registrado con éxito',
                        icon: 'success',
                        confirmButtonText: 'Aceptar'
                    }).then(() => {
                        window.location.href = '/Inventario/Pedidos';
                    });
                })
                .catch(error => {
                    console.error('Error:', error);
                    Swal.fire({
                        title: 'Error',
                        text: error.message,
                        icon: 'error',
                        confirmButtonText: 'Aceptar'
                    });
                });
        }






        $(document).ready(function () {
            $('#buscarProducto').keyup(function () {
                buscarProducto();
            });
        });

    </script>





}
