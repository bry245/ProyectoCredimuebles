                            <th>Estado</th>
                            <th>Precio Total</th>
                            <th>Detalles</th>
                            <th>Recibir Pedido</th>
                        </tr>
                    </thead>
                    <tbody>


                        @foreach (var pedido in ViewBag.Pedidos)
                        {


                            @if (pedido.estado == "En Curso" )
                            {
                                <tr>
                                    <td>@pedido.fechaEncargo</td>
                                    <td>@pedido.estado</td>
                                    <td>@pedido.montoTotalPedido</td>
                                    <input type="hidden" class="idDetallePedido" name="idDetallePedido" value="@pedido.idPedido" />
                                    <td>
                                        <!-- Botón para desplegar el acordeón -->
                                        <button type="button" class="btn btn-primary" data-mdb-toggle="collapse" data-mdb-target="#collapse_@pedido.idPedido" aria-expanded="false" aria-controls="collapse_@pedido.idPedido">
                                            <i class="fas fa-eye"></i>
                                        </button>
                                        <a href="@Url.Action("EditarPedido", "Inventario", new { id = pedido.idPedido })" class="btn btn-danger">Ver más <i class="fa fa-list"></i></a>
                                    </td>
                                    <td>
