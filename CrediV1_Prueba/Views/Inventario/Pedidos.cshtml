                                                            {
                                                                <td>@detalle.fechaRecibido</td>
                                                            }
                                                            <td>@detalle.nombreProducto</td>
                                                            <td>@detalle.cantidad</td>
                                                            <td>@detalle.montoUnitario</td>
                                                            <td>@detalle.montoTotalProducto</td>
                                                            <td>@detalle.nombreProveedor</td>
                                                            @if (detalle.fechaRecibido == null)
                                                            {
                                                                <td style="text-align:center">

                                                                    <button onclick="enviarNotificacion('@detalle.nombreProveedor', '@detalle.correoProveedor')" class="btn btn-success">
                                                                        <i class="fas fa-envelope"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                            else
                                                            {
                                                                <td style="text-align:center">
                                                                    <button disabled class="btn btn-success">
                                                                        <i class="fas fa-check"></i>
                                                                    </button>
                                                                    <button onclick="enviarNotificacion('@detalle.nombreProveedor', '@detalle.correoProveedor')" class="btn btn-success">
                                                                        <i class="fas fa-envelope"></i>
                                                                    </button>
                                                                </td>
                                                            }
                                                        </tr>
                                                    }
                                                }
                                            </tbody>
                                        </table>
                                    </td>
                                </tr>
                            }
                            
                        }
                    </tbody>
                </table>
            </div>
