@model IEnumerable<CrediV1_Prueba.Entities.ProductoEnt>
@{
    ViewData["Title"] = "Listado de Productos";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@section Estilos {
    <link href="~/css/tablas.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.css">
}

<div class="container">
    <div class="container mt-4">
        <a href="@Url.Action("AgregarProducto", "Inventario")" class="btn" type="submit" id="button-addon2"> <i class="fa fa-plus"></i> Agregar Producto </a>
    </div>

    <div class="container mt-4">
        <table id="productosTable" class="table table-striped table-bordered" style="width:100%">
            <thead>
                <tr>
                    <th>Nombre del Producto</th>
                    <th>Costo</th>
                    <th>Cantidad Stock</th>
                    <th>Categoria </th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in Model)
                {
                    <tr>
                        <input type="hidden"  />
                        <td>@producto.nombre</td>
                        <td>@producto.costo</td>   
                        <td>@producto.cantidadStock</td>
                        <td>@producto.CategoriaNombre</td>
                        @if (producto.estado)
                        {
                            <td>Activo</td>
                            <td style="text-align:center">
                                <button class="btn btn-danger confirmButtonInactivar"
                                        data-id="@producto.idProducto"
                                        data-nombre="@producto.nombre"
                                        data-estado="false">
                                    Inactivar
                                </button>
                                <a class="btn btn-warning" asp-controller="Inventario" asp-action="EditarProducto" asp-route-idProducto="@producto.idProducto">Editar</a>
                            </td>
                        }
                        else
                        {
                            <td>Inactivo</td>
                            <td style="text-align:center">
                                <button class="btn btn-success confirmButtonInactivar"
                                        data-id="@producto.idProducto"
                                        data-nombre="@producto.nombre"
                                        data-estado="true">
                                    Activar
                                </button>
                                <a class="btn btn-warning" asp-controller="Inventario" asp-action="EditarProducto" asp-route-idProducto="@producto.idProducto">Editar</a>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@section Scripts {
    <script type="text/javascript" charset="utf8" src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        $(document).ready(function () {
            $('#productosTable').DataTable({
                "paging": true,
                "searching": true,
                "info": true,
                "ordering": true,
                "pageLength": 10,
                "language": {
                    "paginate": {
                        "previous": "Anterior",
                        "next": "Siguiente"
                    },
                    "search": "Buscar:",
                    "lengthMenu": "Mostrar _MENU_ filas por página",
                    "info": "Mostrando _START_ a _END_ de _TOTAL_ filas",
                    "infoEmpty": "Mostrando 0 a 0 de 0 filas",
                    "emptyTable": "No hay datos disponibles en la tabla",
                    "infoFiltered": "(filtrado de _MAX_ filas en total)",
                    "zeroRecords": "No se encontraron coincidencias"
                }
            });

            $('.confirmButtonInactivar').on('click', function () {
                let idProducto = $(this).data('id');
                let nombre = $(this).data('nombre');
                let estado = $(this).data('estado');

                let accion = estado ? "activar" : "inactivar";

                Swal.fire({
                    title: `¿Estás seguro de ${accion} el producto ${nombre}?`,
                    text: ``,
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#3085d6',
                    cancelButtonColor: '#d33',
                    confirmButtonText: 'Sí, continuar',
                    cancelButtonText: 'Cancelar'
                }).then(async (result) => {
                    if (result.isConfirmed) {
                        try {
                            const response = await fetch('/Inventario/DesactivarProducto', {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify({ idProducto: idProducto })
                            });

                            if (response.ok) {
                                const mensaje = await response.text();
                                Swal.fire({
                                    icon: 'success',
                                    title: 'Acción Realizada',
                                    text: mensaje
                                }).then(() => {
                                    location.reload();
                                });
                            } else {
                                throw new Error('Error en la solicitud');
                            }
                        } catch (error) {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error',
                                text: 'Hubo un problema al cambiar el estado del producto.'
                            });
                        }
                    }
                });
            });
        });
    </script>
}
